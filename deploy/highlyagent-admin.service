# HighLyAgent Admin Dashboard — systemd unit (LOCAL MACHINE ONLY)
#
#   sudo cp deploy/highlyagent-admin.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now highlyagent-admin
#
# Auto-starts at boot, auto-restarts on crash. Binds 127.0.0.1:8090.
[Unit]
Description=HighLyAgent Admin Dashboard (local)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/highlyagent
ExecStart=/usr/bin/node /opt/highlyagent/scripts/serve-dist.mjs
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8090
Environment=HLA_API_BASE=https://api.highlyagent.io
# hardening — the dashboard never needs these
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/highlyagent
PrivateTmp=true

[Install]
WantedBy=multi-user.target
