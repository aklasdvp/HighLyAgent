# ── HighLyAgent Environment ─────────────────────────────
APP_NAME=HighLyAgent
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=https://admin.highlyagent.io,https://app.highlyagent.io

# ── Database (PostgreSQL + pgvector) ────────────────────
DATABASE_URL=postgresql+asyncpg://highlyagent:CHANGE_ME@db:5432/highlyagent
VECTOR_DIM=1536

# ── Redis (short-term memory + cache + celery broker) ──
REDIS_URL=redis://redis:6379/0
KNOWLEDGE_CACHE_TTL=300
STM_TTL_SECONDS=1800

# ── Auth ────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_64_char_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160
ENCRYPTION_KEY=CHANGE_ME_fernet_key

# ── AI Providers (all manual — no auto-configuration) ──
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
DEFAULT_PROVIDER=openai
FALLBACK_CHAIN=openai,claude,gemini,deepseek
EMBEDDING_MODEL=text-embedding-3-small

# ── Self-Learning ───────────────────────────────────────
SIMILARITY_THRESHOLD=0.40
AUTO_LEARN=true

# ── Security hardening ─────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
MAX_INPUT_LENGTH=4000
CSRF_ENABLED=true
AUDIT_ENABLED=true
