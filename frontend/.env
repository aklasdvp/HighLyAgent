# ── HighLyAgent Frontend — backend connection ─────────────────────────
# Edit these, then `npm run build` (or just restart `npm run dev`).
# VITE_* variables are embedded at build time by Vite.

# REST API of the backend server (DigitalOcean / VPS, docker compose)
VITE_API_URL=https://api.highlyagent.io

# Real-time WebSocket gateway of the same backend
VITE_WS_URL=wss://api.highlyagent.io/ws

# REST route prefix. The backend serves endpoints at the root now
# (/auth/login, /projects, /agent/process …) — leave this empty.
# Set it only if your backend re-introduces a versioned prefix (e.g. /api/v1).
VITE_API_PREFIX=

# true  → dashboard runs on its built-in demo data store (works with no backend)
# false → real API calls to VITE_API_URL (JWT login against /auth/*)
VITE_SIMULATED=true
