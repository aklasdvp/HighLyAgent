# HighLyAgent Admin Dashboard — systemd unit (LOCAL MACHINE ONLY)
#
#   1. Copy this repo to /opt/highlyagent-frontend
#   2. npm ci && npm run build
#   3. sudo cp deploy/highlyagent-admin.service /etc/systemd/system/
#   4. sudo systemctl daemon-reload && sudo systemctl enable --now highlyagent-admin
#
# Auto-starts at boot, auto-restarts on crash. Binds 127.0.0.1:8090.
[Unit]
Description=HighLyAgent Admin Dashboard (local)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/highlyagent-frontend
ExecStart=/usr/bin/node /opt/highlyagent-frontend/scripts/serve-dist.mjs
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8090
# hardening — the dashboard never needs these
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/highlyagent-frontend
PrivateTmp=true

[Install]
WantedBy=multi-user.target
