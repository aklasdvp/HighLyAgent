{
  "name": "highlyagent-frontend",
  "private": true,
  "version": "2.4.1",
  "type": "module",
  "description": "HighLyAgent Admin Control Center — local-only dashboard for the Universal AI Middleware. Runs on your machine (PM2 / systemd / Electron) and talks to the FastAPI backend over HTTPS + WSS.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "serve": "node scripts/serve-dist.mjs",
    "sync:src": "node scripts/sync-src.mjs",
    "electron": "electron desktop/main.cjs",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 delete highlyagent-admin"
  },
  "dependencies": {
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
