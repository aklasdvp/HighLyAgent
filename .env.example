# HighLyAgent runtime configuration. Copy to .env and replace every placeholder.
APP_NAME=HighLyAgent
ENVIRONMENT=development
API_V1_PREFIX=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8090

# PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://highlyagent:CHANGE_ME@localhost:5432/highlyagent
DB_PASSWORD=CHANGE_ME
VECTOR_DIM=1536

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
KNOWLEDGE_CACHE_TTL=300
STM_TTL_SECONDS=1800

# JWT
JWT_SECRET_KEY=CHANGE_ME_use_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# AI providers: leave unused provider keys blank
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEFAULT_PROVIDER=openai
FALLBACK_CHAIN=openai,claude,gemini,deepseek

# Agent behaviour
SIMILARITY_THRESHOLD=0.40
AUTO_LEARN=true
RATE_LIMIT_PER_MINUTE=60
MAX_INPUT_LENGTH=4000
