# HighLyAgent runtime configuration. Copy to .env and replace every placeholder.
APP_NAME=HighLyAgent
ENVIRONMENT=development
API_V1_PREFIX=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8090

# PostgreSQL + pgvector
ALLOWED_ORIGINS=["*"]
DATABASE_URL=postgresql+asyncpg://highlyagent:aklas8689@localhost:5433/highlyagent
DB_PASSWORD=aklas8689
VECTOR_DIM=1536

# Redis / Celery
REDIS_URL=redis://localhost:6380/0
KNOWLEDGE_CACHE_TTL=300
STM_TTL_SECONDS=1800

# JWT
JWT_SECRET_KEY=Aklas_use_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# Management API Key — used by the Admin Dashboard (HighLyAgent Manager) for
# management endpoints only. Never share this with a client project.
MANAGEMENT_API_KEY=hl_mgmt_change_me_to_a_long_random_secret

# Simple management authentication via .env (no database users needed)
# MANAGEMENT_USERNAME: Username for management login (default: admin)
# MANAGEMENT_EMAIL: Email for management login (optional, for reference)
# MANAGEMENT_PASSWORD: Plain text password for management login (stored as plain text in .env)
MANAGEMENT_USERNAME=admin
MANAGEMENT_EMAIL=admin@highlyagent.com
MANAGEMENT_PASSWORD=change_me_to_your_secure_password

# AI providers: leave unused provider keys blank
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEFAULT_PROVIDER=openai
FALLBACK_CHAIN=openai,claude,gemini,deepseek

# Agent behaviour
SIMILARITY_THRESHOLD=0.40
AUTO_LEARN=true
RATE_LIMIT_PER_MINUTE=60
MAX_INPUT_LENGTH=4000
