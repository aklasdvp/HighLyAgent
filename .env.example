# HighLyAgent backend configuration
APP_NAME=HighLyAgent
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8090

# PostgreSQL + pgvector (use db/redis host names inside Docker)
DATABASE_URL=postgresql+asyncpg://highlyagent:CHANGE_ME@db:5432/highlyagent
DB_PASSWORD=CHANGE_ME
VECTOR_DIM=1536

# Redis / Celery
REDIS_URL=redis://redis:6379/0
KNOWLEDGE_CACHE_TTL=300
STM_TTL_SECONDS=1800

# Authentication
JWT_SECRET_KEY=CHANGE_ME_use_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# Providers (configure only the providers you use)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEFAULT_PROVIDER=openai
FALLBACK_CHAIN=openai,claude,gemini,deepseek

SIMILARITY_THRESHOLD=0.40
AUTO_LEARN=true
RATE_LIMIT_PER_MINUTE=60
MAX_INPUT_LENGTH=4000
